;;; darkmatter-theme.el --- A near-black theme with an ember accent -*- lexical-binding: t; -*-

;; Author: Steve Simkins
;; URL: https://github.com/darkmattertheme/emacs
;; Version: 0.1.0
;; Package-Requires: ((emacs "24.1"))
;; Keywords: faces themes
;; SPDX-License-Identifier: MIT

;;; Commentary:

;; Darkmatter (https://darkmattertheme.com) for Emacs. A near-black palette
;; with an ember accent, adapted from base16 Black Metal Bathory.
;;
;; Load it with:
;;
;;   (load-theme 'darkmatter t)
;;
;; Doom Emacs users can use doom-darkmatter-theme.el from the same repo.

;;; Code:

(deftheme darkmatter
  "A near-black theme with an ember accent, adapted from Black Metal Bathory.")

(let ((class '((class color) (min-colors 89)))
      ;; Darks
      (void      "#121113")   ; base00 - background
      (umbra     "#121212")   ; base01 - lighter background
      (shadow    "#222222")   ; base02 - selection
      (dust      "#333333")   ; base03 - comments, borders, line numbers
      ;; Lights
      (ash       "#999999")   ; base04 - muted text
      (starlight "#c1c1c1")   ; base05 - body text
      ;; Accents
      (aurora    "#5f8787")   ; base08 - variables, tags, errors
      (meteor    "#aaaaaa")   ; base09 - integers, constants
      (ember     "#e78a53")   ; base0A - the accent
      (solar     "#fbcb97")   ; base0B - strings, inserted
      (corona    "#aaaaaa")   ; base0C - support, escapes
      (nebula    "#888888")   ; base0D - functions, headings
      (pulsar    "#999999")   ; base0E - keywords, storage
      (eclipse   "#444444")   ; base0F - deprecated, embeds
      ;; Terminal
      (white     "#ffffff"))

  (custom-theme-set-faces
   'darkmatter

